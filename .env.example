# Launch27 staff account used to read bookings
L27_EMAIL=
L27_PASSWORD=
L27_BASE_URL=https://urbanmop.launch27.com

# Kustomer form hook that receives changed bookings
KUSTOMER_WEBHOOK_URL=

# Optional
TIMEZONE=America/New_York
# Hours (in TIMEZONE) that --loop mode polls, inclusive: 7-23 = 7:00 AM to 11:59 PM
ACTIVE_HOURS=7-23
POLL_SECONDS=60
# Where the cached token and last snapshot are kept (default: ./state)
# STATE_DIR=/var/lib/checkin-tracker
# Set to true to log changes without sending them to Kustomer
DRY_RUN=false
